{
  "name": "@travel/agent-runtime",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @travel/capability-gateway build && pnpm --filter @travel/application build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @travel/capability-gateway build && pnpm --filter @travel/application build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@travel/contracts": "workspace:*", "@travel/application": "workspace:*", "@travel/capability-gateway": "workspace:*", "zod": "^3.25.76" },
  "devDependencies": { "@types/node": "^22.15.3", "typescript": "^5.8.3", "eslint": "^9.24.0", "vitest": "^3.1.1" }
}
