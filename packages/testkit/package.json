{
  "name": "@travel/testkit",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "pretest": "pnpm --filter @travel/application build && pnpm --filter @travel/security build && pnpm --filter @travel/supplier-adapters build && pnpm --filter @travel/vault build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@travel/application": "workspace:*",
    "@travel/contracts": "workspace:*",
    "@travel/domain": "workspace:*",
    "@travel/security": "workspace:*",
    "@travel/supplier-adapters": "workspace:*",
    "@travel/vault": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "eslint": "^9.24.0",
    "vitest": "^3.1.1"
  },
  "type": "module"
}
