{
  "name": "@travel/domain",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @travel/contracts build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @travel/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "pretest": "pnpm --filter @travel/contracts build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@travel/contracts": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
