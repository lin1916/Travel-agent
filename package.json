{
  "name": "travel-agent",
  "version": "0.1.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:full-flow": "pnpm --filter @travel/testkit test -- --run full-trip",
    "db:migrate": "pnpm --filter @travel/persistence db:migrate",
    "smoke:conversation-first": "pnpm --filter @travel/api smoke:conversation-first",
    "security:scan-sensitive-output": "node packages/security/scripts/scan-sensitive-output.mjs apps packages",
    "ci": "pnpm typecheck && pnpm lint && pnpm db:migrate && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm test:full-flow && pnpm --filter @travel/api exec vitest run test/full-trip-flow.e2e-spec.ts && pnpm --filter @travel/web test:e2e -- full-trip-flow.spec.ts && pnpm audit --audit-level=high && pnpm security:scan-sensitive-output"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.29.1",
    "turbo": "2.10.11",
    "typescript": "^5.8.3",
    "eslint": "^9.24.0"
  }
}
