{
  "name": "@travel/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prebuild": "pnpm --filter @travel/application build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @travel/application build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "pretest": "pnpm --filter @travel/application build",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@travel/application": "workspace:*",
    "@travel/contracts": "workspace:*",
    "@travel/persistence": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "eslint": "^9.24.0"
  },
  "type": "module"
}
