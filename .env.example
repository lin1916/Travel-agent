NODE_ENV=development
LOCAL_PLANNING_MEMORY_MODE=false
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://travel:travel@localhost:5432/travel_agent
VAULT_DATABASE_URL=postgresql://travel_vault:travel_vault@localhost:5433/travel_vault
KMS_PROVIDER=local
VAULT_LOCAL_KEY_BASE64=replace-with-32-byte-base64-key
VAULT_LOCAL_KEY_VERSION=local-v1
VAULT_INTERNAL_SERVICE_TOKEN=replace-with-long-random-service-token
VAULT_INTERNAL_SERVICE_ID=travel-api
VAULT_BIND_HOST=127.0.0.1
TRAVEL_LLM_BASE_URL=https://apizh-ai.com
TRAVEL_LLM_RESPONSES_PATH=/responses
TRAVEL_LLM_API_KEY=
TRAVEL_LLM_MODEL=gpt-5.5
TRAVEL_LLM_REASONING_EFFORT=xhigh
TRAVEL_LLM_TIMEOUT_MS=30000
TRAVEL_AGENT_RUNTIME=legacy
TRAVEL_AGENT_TEST_PROVIDER=
AMAP_WEB_SERVICE_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
